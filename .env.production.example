APP_NAME=Monitoring System
ENVIRONMENT=production

# CHANGE THIS before first start. Keep it stable after ESXi passwords are saved.
SECRET_KEY=replace-with-64-character-random-secret

POSTGRES_DB=monitoring
POSTGRES_USER=monitor
POSTGRES_PASSWORD=replace-with-strong-db-password
DATABASE_URL=postgresql+psycopg2://monitor:replace-with-strong-db-password@postgres:5432/monitoring
REDIS_URL=redis://redis:6379/0

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-admin-password
TOKEN_EXPIRE_MINUTES=60

FRONTEND_PORT=3000
BACKEND_PORT=8000

COLLECT_INTERVAL_SECONDS=60
NETWORK_CHECK_INTERVAL_SECONDS=10
PING_COUNT=4
PING_TIMEOUT_SECONDS=1.5
ALERT_COOLDOWN_SECONDS=300
CPU_WARNING_DURATION_SECONDS=300

# Example: http://192.168.1.10:3000,http://monitoring.example.uz
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=monitoring@example.com
SMTP_TO=
SMTP_USE_TLS=true
